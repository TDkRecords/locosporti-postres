{
	"name": "locosporti-postres",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev:admin": "vite dev --mode admin",
		"dev:cliente": "vite dev --mode cliente",
		"build": "vite build",
		"build:admin": "node scripts/build-target.mjs admin",
		"build:cliente": "node scripts/build-target.mjs cliente",
		"cap:sync:admin": "cross-env CAPACITOR_TARGET=admin cap sync android",
		"cap:sync:cliente": "cross-env CAPACITOR_TARGET=cliente cap sync android",
		"android:admin": "pnpm run build:admin && pnpm exec cap sync android && cd android && gradlew.bat assembleAdminRelease",
		"android:cliente": "pnpm run build:cliente && pnpm exec cap sync android && cd android && gradlew.bat assembleClienteRelease",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''"
	},
	"devDependencies": {
		"@capacitor/cli": "^8.5.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^26.2.0",
		"cross-env": "^10.1.0",
		"svelte": "^5.56.1",
		"tailwindcss": "^4.3.0",
		"typescript": "^7.0.2",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@capacitor-community/fcm": "^8.1.0",
		"@capacitor/android": "^8.5.0",
		"@capacitor/core": "^8.5.0",
		"@capacitor/push-notifications": "^8.1.2",
		"@codetrix-studio/capacitor-google-auth": "3.4.0-rc.4",
		"@fortawesome/fontawesome-free": "^7.3.1",
		"cloudinary": "^2.10.0",
		"firebase": "^12.17.1",
		"qrcode": "^1.5.4",
		"uuid": "^14.0.1"
	}
}